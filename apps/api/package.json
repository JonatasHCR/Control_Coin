{
  "name": "@cc/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start": "node dist/src/main.js",
    "seed": "tsc -p tsconfig.build.json && node dist/prisma/seed.js",
    "demo": "tsc -p tsconfig.build.json && node dist/prisma/demo.js",
    "import-extratos": "tsc -p tsconfig.build.json && node dist/prisma/import-extratos.js",
    "fix-karen": "tsc -p tsconfig.build.json && node dist/prisma/fix-karen.js",
    "import-fatura": "tsc -p tsconfig.build.json && node dist/prisma/import-fatura.js"
  },
  "dependencies": {
    "@cc/domain": "*",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@prisma/client": "^5.22.0",
    "decimal.js": "^10.4.3",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@cc/config": "*",
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "type": "module"
}
